[Unit]
Description=soccerstats s2 (gunicorn)
After=network.target postgresql.service

[Service]
User=chris
Group=chris
WorkingDirectory=/home/chris/www/s2
EnvironmentFile=/home/chris/www/s2/.env
ExecStart=/home/chris/www/s2/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8100 wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
