server {
    server_name soccerstats.us;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: Amazonbot\nDisallow: /\n\nUser-agent: ClaudeBot\nCrawl-delay: 10\nDisallow: /games/\n\nUser-agent: GPTBot\nCrawl-delay: 10\nDisallow: /games/\n\nUser-agent: *\nDisallow: /games/\n\nSitemap: https://soccerstats.us/sitemap.xml\n";
    }

    location /static/ {
        alias /home/chris/www/s2/staticfiles/;
    }

    location / {
        # Answer the missing trailing slash here instead of paying a gunicorn
        # round trip for Django's APPEND_SLASH. Crawlers that drop the slash
        # made 79,354 such requests on 2026-08-03, a third of all traffic.
        # Excluding paths with a dot leaves files (sitemaps, anything served
        # by name) alone; a slug containing a dot just falls through to
        # APPEND_SLASH as before. The query string is re-appended by nginx.
        rewrite ^([^.]*[^/])$ $1/ permanent;

        limit_req zone=aibots burst=5 nodelay;
        limit_req zone=amazonbot burst=2 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/soccerstats.us/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/soccerstats.us/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    server_name www.soccerstats.us;
    return 301 https://soccerstats.us$request_uri;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/soccerstats.us/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/soccerstats.us/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = www.soccerstats.us) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = soccerstats.us) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name soccerstats.us www.soccerstats.us;
    return 404; # managed by Certbot
}
