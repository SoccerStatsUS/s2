server {
    server_name stats.soccerstats.us;
    return 301 https://soccerstats.us$request_uri;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/stats.soccerstats.us/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/stats.soccerstats.us/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = stats.soccerstats.us) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name stats.soccerstats.us;
    return 404; # managed by Certbot
}
